PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/taxi_management
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Use these only when creating an admin or driver account with npm run auth:create-user.
SEED_USER_FULL_NAME=YOUR_ADMIN_NAME
SEED_USER_EMAIL=YOUR_ADMIN_EMAIL
SEED_USER_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD
SEED_USER_ROLE=admin

# Local-only role update; confirmation must exactly match ROLE_CHANGE_EMAIL.
ROLE_CHANGE_EMAIL=
ROLE_CHANGE_TO=
ROLE_CHANGE_CONFIRM_EMAIL=
